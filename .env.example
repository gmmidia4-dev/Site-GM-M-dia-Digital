# ===========================================
# GM Mídia Digital — Environment Variables
# Copy this file to .env.local and fill in the values
# ===========================================

# Site URL (used for metadata and emails)
NEXT_PUBLIC_SITE_URL=https://gmmidia.com.br

# Database (PostgreSQL)
DATABASE_URL="postgresql://user:password@localhost:5432/gmmidia_db"

# NextAuth.js
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-super-secret-key-change-this-in-production

# WhatsApp number (without +, with country code: 5511999999999)
NEXT_PUBLIC_WHATSAPP_NUMBER=5511999999999

# SMTP Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=contato@gmmidia.com.br
SMTP_PASS=your-smtp-password

# Email Notifications
NOTIFICATION_EMAIL=contato@gmmidia.com.br

# Analytics (optional)
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
NEXT_PUBLIC_META_PIXEL_ID=XXXXXXXXXXXXXXXXXX
