# =============================================================================
# Reportia — Variáveis de ambiente
# Copie para .env e preencha. NUNCA versione o arquivo .env real.
# =============================================================================

# --- Banco de dados (PostgreSQL) ---------------------------------------------
# Local (docker) ou um provedor gerenciado (Neon, Supabase, Railway, RDS...)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/reportia?schema=public"

# --- Autenticação (NextAuth / JWT) -------------------------------------------
# Gere com: openssl rand -base64 32
NEXTAUTH_SECRET="troque-por-um-segredo-forte"
NEXTAUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Modo demonstração --------------------------------------------------------
# Quando "true", as integrações retornam dados sintéticos (sem chamar as APIs
# externas). Permite rodar a plataforma inteira sem credenciais reais.
DEMO_MODE="true"

# --- Criptografia de tokens das integrações ----------------------------------
# Chave de 32 bytes (base64) usada para cifrar access/refresh tokens no banco.
# Gere com: openssl rand -base64 32
INTEGRATION_ENCRYPTION_KEY="troque-por-uma-chave-de-32-bytes"

# --- Inteligência Artificial (Anthropic Claude) ------------------------------
ANTHROPIC_API_KEY=""
AI_MODEL="claude-opus-4-8"

# --- Meta Ads (Facebook/Instagram) -------------------------------------------
META_APP_ID=""
META_APP_SECRET=""
META_REDIRECT_URI="http://localhost:3000/api/oauth/meta/callback"
META_API_VERSION="v21.0"

# --- Google Ads / Analytics 4 / Search Console (OAuth Google) ----------------
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:3000/api/oauth/google/callback"
GOOGLE_ADS_DEVELOPER_TOKEN=""
GOOGLE_ADS_LOGIN_CUSTOMER_ID=""

# --- TikTok Ads ---------------------------------------------------------------
TIKTOK_APP_ID=""
TIKTOK_APP_SECRET=""
TIKTOK_REDIRECT_URI="http://localhost:3000/api/oauth/tiktok/callback"

# --- LinkedIn Ads -------------------------------------------------------------
LINKEDIN_CLIENT_ID=""
LINKEDIN_CLIENT_SECRET=""
LINKEDIN_REDIRECT_URI="http://localhost:3000/api/oauth/linkedin/callback"

# --- E-mail (Resend) ----------------------------------------------------------
RESEND_API_KEY=""
EMAIL_FROM="Reportia <relatorios@suaagencia.com.br>"

# --- WhatsApp (Meta WhatsApp Cloud API) --------------------------------------
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_TEMPLATE_NAME="relatorio_pronto"

# --- Cron / agendamento (proteção dos endpoints de automação) ----------------
# Gere com: openssl rand -hex 24
CRON_SECRET="troque-por-um-segredo-de-cron"
